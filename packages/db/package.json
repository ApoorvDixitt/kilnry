{
  "name": "@kilnry/db",
  "version": "0.3.2",
  "description": "PGlite and PostgreSQL schema and migrations",
  "private": true,
  "type": "module",
  "author": "Apoorv Dixit (https://github.com/ApoorvDixitt)",
  "license": "SEE LICENSE IN LICENSE.md",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  }
}
