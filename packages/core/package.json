{
  "name": "@kilnry/core",
  "version": "0.3.2",
  "description": "Shared domain, tools, jobs, Library, and security",
  "private": true,
  "type": "module",
  "author": "Apoorv Dixit (https://github.com/ApoorvDixitt)",
  "license": "SEE LICENSE IN LICENSE.md",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config/load.js",
    "./errors": "./dist/errors.js",
    "./events": "./dist/events/hub.js",
    "./ids": "./dist/ids.js",
    "./jobs": "./dist/jobs/engine.js",
    "./library": "./dist/library/index.js",
    "./library/containment": "./dist/library/containment.js",
    "./library/reindex": "./dist/library/reindex.js",
    "./library/root": "./dist/library/root.js",
    "./library/sidecar": "./dist/library/sidecar.js",
    "./providers/adapter": "./dist/providers/adapter.js",
    "./registry": "./dist/registry/store.js",
    "./security/key-store": "./dist/security/key-store.js",
    "./security/key-detection": "./dist/security/key-detection.js",
    "./security/redact": "./dist/security/redact.js",
    "./types": "./dist/types.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs src dist .prompt.md",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'"
  },
  "dependencies": {
    "@kilnry/db": "workspace:*",
    "@kilnry/media": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "chokidar": "5.0.0",
    "drizzle-orm": "0.45.2",
    "pg-boss": "12.33.1",
    "ulidx": "2.4.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
