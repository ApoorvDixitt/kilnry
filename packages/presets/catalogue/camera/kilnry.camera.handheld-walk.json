{
  "schema_version": 1,
  "id": "kilnry.camera.handheld-walk",
  "name": "Handheld Walk",
  "version": "1.0.0",
  "description": "A documentary walk-in with footstep sway and small focus hunts. MiniMax H3 gives the most believable shake.",
  "category": "camera",
  "kind": "video",
  "capability": "image2video",
  "model": {
    "id": "minimax/hailuo-3",
    "locked": false,
    "alternates": ["fal-ai/kling-video/v3/standard/image-to-video", "kwaivgi/kling-v3.0-std"],
    "constraints": { "needs_audio": false, "duration_s": 5 }
  },
  "prompt": "Handheld camera walks slowly toward {{subject}}, natural footstep sway, small focus hunts, documentary feel, {{extra}}",
  "negative_prompt": "gimbal smoothness, cuts, morphing, text",
  "params": {
    "duration_s": 5,
    "audio": false,
    "resolution": "768P"
  },
  "slots": [
    {
      "name": "frame",
      "type": "media",
      "label": "Start frame",
      "required": true,
      "roles": ["start_frame"],
      "accept": ["image"]
    },
    {
      "name": "subject",
      "type": "text",
      "label": "Subject",
      "required": true,
      "max": 200
    },
    {
      "name": "extra",
      "type": "text",
      "label": "Anything else",
      "default": "keep the light of the still",
      "max": 200
    }
  ],
  "medias": [{ "role": "start_frame", "from_slot": "frame" }],
  "count": 1,
  "indicative_cost_usd": 0.42,
  "needs": ["fal", "openrouter"],
  "tags": ["camera", "handheld", "documentary"],
  "license": "CC0-1.0",
  "author": "kilnry"
}
