{
  "schema_version": 1,
  "id": "kilnry.camera.dolly-out",
  "name": "Dolly Out Reveal",
  "version": "1.0.0",
  "description": "Starts tight and pulls back to show where the subject actually is. A reveal you can cut to after a close-up.",
  "category": "camera",
  "kind": "video",
  "capability": "image2video",
  "model": {
    "id": "fal-ai/kling-video/v3/standard/image-to-video",
    "locked": false,
    "alternates": ["kwaivgi/kling-v3.0-std", "fal-ai/veo3.1/lite/image-to-video", "minimax/hailuo-3"],
    "constraints": { "needs_audio": false, "duration_s": 5 }
  },
  "prompt": "Camera starts tight on {{subject}} and dollies back slowly to reveal the full scene, steady, level horizon, {{extra}}",
  "negative_prompt": "shake, tilted horizon, cuts, morphing, text",
  "params": {
    "duration_s": 5,
    "audio": false,
    "resolution": "720p"
  },
  "slots": [
    {
      "name": "frame",
      "type": "media",
      "label": "Start frame",
      "required": true,
      "roles": ["start_frame"],
      "accept": ["image"]
    },
    {
      "name": "subject",
      "type": "text",
      "label": "Subject",
      "required": true,
      "max": 200
    },
    {
      "name": "extra",
      "type": "text",
      "label": "Anything else",
      "default": "keep the light of the still",
      "max": 200
    }
  ],
  "medias": [{ "role": "start_frame", "from_slot": "frame" }],
  "count": 1,
  "indicative_cost_usd": 0.42,
  "needs": ["fal", "openrouter"],
  "tags": ["camera", "dolly", "reveal"],
  "license": "CC0-1.0",
  "author": "kilnry"
}
