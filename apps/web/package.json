{
  "name": "@kilnry/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kilnry local web application",
  "author": "Apoorv Dixit (https://github.com/ApoorvDixitt)",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3123",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3123",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --passWithNoTests --exclude 'src/**/*.browser.test.tsx' --exclude '.next/**'",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@kilnry/core": "workspace:*",
    "@kilnry/db": "workspace:*",
    "@kilnry/mcp": "workspace:*",
    "@kilnry/media": "workspace:*",
    "@kilnry/providers": "workspace:*",
    "@kilnry/ui": "workspace:*",
    "@number-flow/react": "0.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.14.13",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "geist": "1.7.2",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "msw": "2.15.0"
  }
}
