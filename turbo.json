{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "BETTER_AUTH_SECRET",
    "DATABASE_URL",
    "KILNRY_DATA_DIR",
    "KILNRY_DOCKER",
    "KILNRY_HOST",
    "KILNRY_LAN",
    "KILNRY_LIBRARY_ROOT",
    "KILNRY_LOG",
    "KILNRY_MASTER_KEY",
    "KILNRY_MASTER_KEY_FILE",
    "KILNRY_PORT",
    "KILNRY_TLS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
