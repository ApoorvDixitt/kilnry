{
  "name": "kilnry-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first AI media studio",
  "author": "Apoorv Dixit (https://github.com/ApoorvDixitt)",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -b --pretty false && pnpm --filter @kilnry/web typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "turbo run test",
    "test:browser": "pnpm --filter @kilnry/web test:browser",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check:headers": "tsx scripts/check-headers.ts",
    "fix:headers": "tsx scripts/check-headers.ts --fix",
    "check:provenance": "tsx scripts/check-provenance.ts",
    "check:canon": "tsx scripts/check-canon.ts",
    "check:size": "tsx scripts/check-launcher-size.ts",
    "i18n:check": "tsx scripts/check-messages.ts",
    "release": "tsx scripts/release.ts",
    "deps:check": "pnpm outdated -r --long",
    "prepare": "tsx scripts/install-hooks.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "commit-and-tag-version": "12.7.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "turbo": "2.11.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
